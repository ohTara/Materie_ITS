  {
    "id": "parse-meal",
    "type": "function",
    "z": "677804ebca511aee",
    "name": "Parse Meal (JS)",
    "func": "const meal = msg.payload?.meals?.[0];\nif (!meal) return null;\n\nconst ingredients = [];\nfor (let i = 1; i <= 20; i++) {\n  const ing = meal[`strIngredient${i}`];\n  const meas = meal[`strMeasure${i}`];\n  if (ing && ing.trim()) {\n    ingredients.push({ ingredient: ing.trim(), measure: meas?.trim() || '' });\n  }\n}\n\nmsg.mealName = meal.strMeal;\nmsg.mealInstructions = meal.strInstructions;\nmsg.ingredients = ingredients;\nreturn msg;",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 600,
  "y": 1500,
  "wires": [
    [
      "format-output",
      "debug-meal"
    ]
  ]
},
{
  "id": "format-output",
  "type": "function",
  "z": "677804ebca511aee",
    "name": "Format Output (JS)",
    "func": "const lines = [];\nlines.push(`# ${msg.mealName}`);\nlines.push('');\nlines.push('**Ingredienti:**');\nmsg.ingredients.forEach(ing => {\n  const measure = ing.measure ? `${ing.measure} ` : '';\n  lines.push(`${measure}${ing.ingredient}`);\n});\nlines.push('');\nlines.push('**Procedimento:**');\nlines.push(msg.mealInstructions || 'Nessuna istruzione disponibile');\n\nmsg.payload = lines.join('\\n');\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 820,
    "y": 1500,
    "wires": [
      [
        "template-meal"
      ]
    ]
  },
  {
    "id": "template-meal",
    "type": "ui_template",
    "z": "677804ebca511aee",
    "group": "group-meal",
    "name": "Dettaglio Pietanza",
    "order": 2,
    "width": "6",
    "height": "12",
    "format": "<div style=\"max-height: 500px; overflow-y: auto; padding: 12px;\">\n  <div id=\"meal-content\"></div>\n</div>\n\n<script>\n  (function(scope) {\n    scope.$watch('msg.payload', function(newVal) {\n      if (!newVal) return;\n      // Simple markdown-like rendering\n      const html = newVal\n        .replace(/^# (.+)$/gm, '<h2 style=\"margin-top:0;color:#7b1fa2;\">$1</h2>')\n        .replace(/\\*\\*(.+?)\\*\\*/g, '<strong>$1</strong>')\n        .replace(/\\n/g, '<br>');\n      document.getElementById('meal-content').innerHTML = html;\n    });\n  })(scope);\n</script>",
    "storeOutMessages": false,
    "fwdInMessages": false,
    "templateScope": "local",
